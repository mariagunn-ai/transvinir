<div class="admin">
  <h1><%= item ? 'Breyta frétt' : 'Ný frétt' %></h1>
  <p><a href="/admin">&larr; Aftur á stjórnborð</a></p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <form method="post"
        action="<%= item ? '/admin/news/' + item.id : '/admin/news' %>"
        enctype="multipart/form-data"
        class="form">

    <div data-lang-tabs>
      <div class="lang-tabs" role="tablist">
        <button type="button" class="lang-tabs__tab is-active" data-target="is">Íslenska</button>
        <button type="button" class="lang-tabs__tab" data-target="en">English</button>
      </div>

      <div class="lang-pane is-active" data-pane="is">
        <label>
          Titill (íslenska)
          <input type="text" name="title" required value="<%= item ? item.title : '' %>" />
        </label>
        <label>
          Stutt lýsing (valfrjálst)
          <input type="text" name="summary" value="<%= item && item.summary ? item.summary : '' %>" />
        </label>
        <label>
          Texti (Markdown)
          <textarea name="body_md" rows="14" required><%= item ? item.body_md : '' %></textarea>
        </label>
      </div>

      <div class="lang-pane" data-pane="en">
        <p class="muted">Skildu eftir auð til að nota íslensku útgáfuna sem fallback.</p>
        <label>
          Title (English)
          <input type="text" name="title_en" value="<%= item && item.title_en ? item.title_en : '' %>" />
        </label>
        <label>
          Short description (optional)
          <input type="text" name="summary_en" value="<%= item && item.summary_en ? item.summary_en : '' %>" />
        </label>
        <label>
          Body (Markdown)
          <textarea name="body_md_en" rows="14"><%= item && item.body_md_en ? item.body_md_en : '' %></textarea>
        </label>
      </div>
    </div>

    <fieldset class="form__fieldset">
      <legend>Forsíðumynd</legend>
      <% if (item && item.cover_image) { %>
        <p><img src="<%= item.cover_image %>" alt="" style="max-width:200px;border-radius:8px"/></p>
        <label class="inline">
          <input type="checkbox" name="remove_cover" value="1" />
          Fjarlægja núverandi mynd
        </label>
      <% } %>
      <label>
        Hlaða upp nýrri mynd
        <input type="file" name="cover_image_file" accept="image/*" />
      </label>
      <label>
        ... eða slóð á mynd
        <input type="text" name="cover_image_url" placeholder="https://..." value="<%= item && item.cover_image && !item.cover_image.startsWith('/uploads') ? item.cover_image : '' %>" />
      </label>
    </fieldset>

    <label class="inline">
      <input type="checkbox" name="published" value="1" <%= (!item || item.published) ? 'checked' : '' %> />
      Birta á vef
    </label>

    <div class="form__actions">
      <button type="submit" class="button"><%= item ? 'Vista breytingar' : 'Búa til frétt' %></button>
      <a href="/admin" class="button button--ghost">Hætta við</a>
    </div>
  </form>
</div>
