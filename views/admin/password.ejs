<div class="admin">
  <h1>Breyta lykilorði</h1>
  <p><a href="/admin">&larr; Aftur á stjórnborð</a></p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <% if (success) { %><p class="success"><%= success %></p><% } %>
  <form method="post" action="/admin/password" class="form">
    <label>
      Núverandi lykilorð
      <input type="password" name="current" required autocomplete="current-password" />
    </label>
    <label>
      Nýtt lykilorð (a.m.k. 8 stafir)
      <input type="password" name="next" required minlength="8" autocomplete="new-password" />
    </label>
    <label>
      Staðfesta nýtt lykilorð
      <input type="password" name="confirm" required minlength="8" autocomplete="new-password" />
    </label>
    <button type="submit" class="button">Vista</button>
  </form>
</div>
